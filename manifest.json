{
  "manifest_version": 3,
  "name": "Zen Mute Toggle",
  "version": "1.0.0",
  "description": "Mute / unmute all pinned (Essential) tabs with a single button.",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Mute Essential tabs",
    "default_icon": "icon.svg",
    "default_area": "navbar"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-mute-toggle@todiadiyatmo",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
